-# ============================================================
-# Habilitate IoT Gateway — environment variables
-# Copy this file to .env and fill in the values.
-# NEVER commit .env to source control.
-# ============================================================
-
-# Supabase project URL (from Settings → API)
-SUPABASE_URL=https://your-project.supabase.co
-
-# Service-role key — bypasses RLS for server-side inserts.
-# Found in Settings → API → service_role.
-# Keep this secret. Never expose it to the browser.
-SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
-
-# Port the gateway WebSocket server listens on (default: 8080)
-PORT=8080
-
-# Host to bind to (default: 0.0.0.0 = all interfaces)
-HOST=0.0.0.0
